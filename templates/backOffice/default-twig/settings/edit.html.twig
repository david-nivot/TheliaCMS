{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Site settings'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-settings{% endblock %}

{% block content %}
    {% form_theme form with bo_form_themes only %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Site settings'|trans({}, 'theliacms') } %}
        {% block actions %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.settings.page_types.list') }}" data-testid="cms-settings-page-types">
                <i class="bi bi-diagram-3 me-1" aria-hidden="true"></i>{{ 'Page templates'|trans({}, 'theliacms') }}
            </a>
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.pages.list', { edit_language_id: edit_language_id }) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to pages'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    {{ form_start(form) }}
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        {{ form_errors(form) }}

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">{{ 'This site'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.siteMode) }}

                        <ul class="text-muted small ps-3 mb-2">
                            <li>{{ 'A showcase site answers 404 on the cart and the checkout.'|trans({}, 'theliacms') }}</li>
                            <li>{{ 'CMS comes first in this menu, before the shop.'|trans({}, 'theliacms') }}</li>
                            <li>{{ 'Nothing else changes, and switching back undoes it.'|trans({}, 'theliacms') }}</li>
                        </ul>

                        {% if is_showcase and not editor_profile_exists %}
                            <p class="text-muted small mb-0">
                                {{ 'Saving in showcase mode creates the "Editor" profile: pages, menus, media and news, and nothing of the shop.'|trans({}, 'theliacms') }}
                            </p>
                        {% elseif editor_profile_exists %}
                            <p class="text-muted small mb-0">
                                <i class="bi bi-check2 me-1" aria-hidden="true"></i>
                                {{ 'The "Editor" profile exists. Its permissions are yours to change under Configuration > Administrators.'|trans({}, 'theliacms') }}
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Two short cards stacked beside the tall one, rather than one of
               them alone on a row of its own with a hole next to it. #}
            <div class="col-lg-6 d-flex flex-column gap-3">
                <div class="card">
                    <div class="card-header">{{ 'Address not found'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.notFoundPageId) }}
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">{{ 'Shared cache'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.httpCacheTtl) }}

                        <p class="text-muted small mb-0">
                            {{ 'Pages are tagged so that publishing one drops that page from the cache rather than the whole site.'|trans({}, 'theliacms') }}
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">{{ 'Bin'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        {{ form_row(form.trashRetentionDays) }}

                        <p class="text-muted small mb-0">
                            {{ 'The clean-up runs with the scheduled maintenance of the site, and the bin says when each page is due.'|trans({}, 'theliacms') }}
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header">{{ 'Maintenance'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                {{ form_row(form.maintenanceActive) }}
                                {{ form_row(form.maintenancePageId) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.maintenanceAllowlist) }}
                                {% if client_ip %}
                                    <p class="text-muted small">
                                        {{ 'You are connecting from %ip%.'|trans({'%ip%': client_ip}, 'theliacms') }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>

                        <p class="text-muted small mb-0">
                            {{ 'While the site is closed, visitors get a 503 answer asking them to come back in %minutes% minutes, and the back office stays reachable.'|trans({'%minutes%': (retry_after / 60)|round}, 'theliacms') }}
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header">{{ 'Security headers'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                {{ form_row(form.cspMode) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.cspHosts) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card" data-testid="cms-settings-generator">
                    <div class="card-header">{{ 'Generator'|trans({}, 'theliacms') }}</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-lg-6">
                                {{ form_row(form.generatorEffort) }}
                            </div>
                            <div class="col-lg-6">
                                {{ form_row(form.generatorMaxTokens) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.generatorWebFetch, { row_attr: { class: 'mb-1' } }) }}
                                {# The back-office theme renders help in the label, and its checkbox label leaves it out. #}
                                <p class="text-muted small" data-testid="cms-settings-web-fetch-help">{{ form.generatorWebFetch.vars.help|trans({}, 'theliacms') }}</p>
                            </div>
                            <div class="col-12">
                                {{ form_row(form.generatorComponentMaking, { row_attr: { class: 'mb-1' } }) }}
                                <p class="text-muted small" data-testid="cms-settings-component-making-help">{{ form.generatorComponentMaking.vars.help|trans({}, 'theliacms') }}</p>
                            </div>
                            <div class="col-12">
                                {{ form_row(form.aiLabel, { row_attr: { class: 'mb-1' } }) }}
                                <p class="text-muted small" data-testid="cms-settings-ai-label-help">{{ form.aiLabel.vars.help|trans({}, 'theliacms') }}</p>
                            </div>
                        </div>

                        <div class="border-top pt-3 mb-3" data-testid="cms-settings-generator-text">
                            <h3 class="h6">{{ 'Texts written from a brief'|trans({}, 'theliacms') }}</h3>
                            <p class="text-muted small">{{ 'The summary, description and conclusion of a page or of an item of the catalogue, written from a brief beside the field.'|trans({}, 'theliacms') }}</p>
                            <div class="row g-3">
                                <div class="col-lg-6">{{ form_row(form.textEffort) }}</div>
                                <div class="col-lg-6">{{ form_row(form.textMaxTokens) }}</div>
                            </div>
                        </div>

                        <p class="text-muted small mb-0">
                            {{ 'The AI provider, its key, the model, the budget and the limits of the generator are set in the AI settings of Thelia, not here. This card only holds how the generator asks.'|trans({}, 'theliacms') }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary" data-testid="cms-settings-submit">{{ 'Save'|trans({}, 'theliacms') }}</button>
        </div>
    {{ form_end(form) }}
{% endblock %}

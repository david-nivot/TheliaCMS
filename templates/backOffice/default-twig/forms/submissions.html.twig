{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Answers'|trans({}, 'theliacms') }}{% endblock %}
{% block body_testid %}cms-form-submissions{% endblock %}

{% block head_extra %}
    <style>
        {% include '@TheliaCMSModule/backOffice/default-twig/_filter_bar.css.twig' %}
    </style>
{% endblock %}

{% block content %}
    {% set list_parameters = filters.parameters|merge({ edit_language_id: edit_language_id }) %}
    {% set list_fields = filters.hiddenFields|merge([{ name: 'edit_language_id', value: edit_language_id }]) %}
    {% set may_select = may_change or may_delete %}

    {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: block('title') } %}
        {% block title %}
            {{ 'Answers'|trans({}, 'theliacms') }}
            <span class="text-muted fs-6 ms-2">{{ cms_form.title|default(cms_form.code) }}</span>
        {% endblock %}

        {% block actions %}
            {# The export takes the list as it is shown: the same address, the
               same status. #}
            <a class="btn btn-sm btn-outline-secondary" data-testid="cms-submissions-summary-link"
               href="{{ path('admin.cms.forms.submissions_summary', filters.parameters|merge({ id: cms_form.id, edit_language_id: edit_language_id })) }}">
                <i class="bi bi-bar-chart me-1" aria-hidden="true"></i> {{ 'Answer summary'|trans({}, 'theliacms') }}
            </a>
            {% if total > 0 and may_export %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.submissions_export', filters.parameters|merge({ id: cms_form.id, format: 'csv' })) }}">
                    <i class="bi bi-filetype-csv me-1" aria-hidden="true"></i> {{ 'Export as CSV'|trans({}, 'theliacms') }}
                </a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.submissions_export', filters.parameters|merge({ id: cms_form.id, format: 'json' })) }}">
                    <i class="bi bi-filetype-json me-1" aria-hidden="true"></i> {{ 'Export as JSON'|trans({}, 'theliacms') }}
                </a>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin.cms.forms.edit', { id: cms_form.id, edit_language_id: edit_language_id }) }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to the form'|trans({}, 'theliacms') }}
            </a>
        {% endblock %}
    {% endembed %}

    {% set list_route = 'admin.cms.forms.submissions' %}
    {% include '@TheliaCMSModule/backOffice/default-twig/forms/_submission_filters.html.twig' %}

    {% include '@TheliaCMSModule/backOffice/default-twig/forms/_submission_statuses.html.twig' %}

    {% if submissions is empty %}
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                {% if filters.narrowed and not email %}
                    {{ 'No answer matches these filters.'|trans({}, 'theliacms') }}
                {% elseif email %}
                    {{ 'No answer from this address.'|trans({}, 'theliacms') }}
                {% elseif filters.statusParameter %}
                    {{ 'No answer here.'|trans({}, 'theliacms') }}
                {% else %}
                    {{ 'No answer yet. They will show up here as visitors send the form.'|trans({}, 'theliacms') }}
                {% endif %}
            </div>
        </div>
    {% else %}
        {% if may_select %}
            {# The boxes of the cards belong to this form by their `form`
               attribute; it works without JavaScript, the script only adds the
               box selecting the page and the question before a deletion. #}
            <form method="post" id="cms-submissions-bulk" data-cms-submissions-bulk data-testid="cms-submissions-bulk"
                  class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 border rounded bg-body-tertiary sticky-top"
                  action="{{ path('admin.cms.forms.submissions_bulk', { id: cms_form.id }) }}"
                  data-confirm-delete="{{ 'Delete the selected answers for good? This is what answering a request to be forgotten does.'|trans({}, 'theliacms') }}">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                {% for field in list_fields %}
                    <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
                {% endfor %}
                <input type="hidden" name="page" value="{{ page }}">
                <div class="form-check mb-0 me-2">
                    <input class="form-check-input" type="checkbox" id="cms-submissions-select-all" data-cms-submissions-select-all hidden>
                    <label class="form-check-label small" for="cms-submissions-select-all" data-cms-submissions-selected hidden>{{ 'Select the page'|trans({}, 'theliacms') }}</label>
                </div>
                <label class="visually-hidden" for="cms-submissions-bulk-action">{{ 'With the selected answers'|trans({}, 'theliacms') }}</label>
                <select class="form-select form-select-sm w-auto" id="cms-submissions-bulk-action" name="action" data-testid="cms-submissions-bulk-action">
                    <option value="">{{ 'With the selected answers…'|trans({}, 'theliacms') }}</option>
                    {% if may_change %}
                        <option value="handled">{{ 'Mark as handled'|trans({}, 'theliacms') }}</option>
                        <option value="new">{{ 'Mark as new'|trans({}, 'theliacms') }}</option>
                        <option value="archived">{{ 'Archive'|trans({}, 'theliacms') }}</option>
                    {% endif %}
                    {% if may_delete %}
                        <option value="delete">{{ 'Delete'|trans({}, 'theliacms') }}</option>
                    {% endif %}
                </select>
                <button type="submit" class="btn btn-sm btn-primary" data-cms-submissions-bulk-apply>{{ 'Apply'|trans({}, 'theliacms') }}</button>
            </form>
        {% endif %}

        <div class="d-flex flex-column gap-3">
            {% for submission in submissions %}
                <div class="card" id="cms-submission-{{ submission.id }}" data-testid="cms-submission-{{ submission.id }}">
                    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="d-flex flex-wrap align-items-center gap-2">
                            {% if may_select %}
                                <input class="form-check-input mt-0" type="checkbox" form="cms-submissions-bulk" name="submissions[]" value="{{ submission.id }}"
                                       data-cms-submissions-select aria-label="{{ 'Select the answer of %date%'|trans({ '%date%': submission.created_at }, 'theliacms') }}">
                            {% endif %}
                            <strong>{{ submission.created_at }}</strong>
                            {% if submission.email %}
                                <span class="text-muted">{{ submission.email }}</span>
                            {% endif %}
                            <span class="badge bg-light text-dark border">{{ submission.locale }}</span>
                            <span class="badge {{ submission.status.badge }}" data-testid="cms-submission-status-{{ submission.id }}">{{ submission.status.label|trans({}, 'theliacms') }}</span>
                        </span>
                        <span class="d-flex flex-wrap gap-1">
                            {% if may_change %}
                                {% for status in statuses|filter(s => s != submission.status) %}
                                    <form method="post" action="{{ path('admin.cms.forms.submissions_status', { id: cms_form.id, submissionId: submission.id }) }}">
                                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                                        <input type="hidden" name="to" value="{{ status.value }}">
                                        {% for field in list_fields %}
                                            <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
                                        {% endfor %}
                                        <input type="hidden" name="page" value="{{ page }}">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" data-testid="cms-submission-{{ submission.id }}-to-{{ status.value }}">
                                            {% if status.value == 'handled' %}
                                                <i class="bi bi-check2 me-1" aria-hidden="true"></i>{{ 'Mark as handled'|trans({}, 'theliacms') }}
                                            {% elseif status.value == 'new' %}
                                                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>{{ 'Mark as new'|trans({}, 'theliacms') }}
                                            {% else %}
                                                <i class="bi bi-archive me-1" aria-hidden="true"></i>{{ 'Archive'|trans({}, 'theliacms') }}
                                            {% endif %}
                                        </button>
                                    </form>
                                {% endfor %}
                            {% endif %}
                            {% if may_delete %}
                                <form method="post" action="{{ path('admin.cms.forms.submissions_delete', { id: cms_form.id, submissionId: submission.id }) }}"
                                      onsubmit="return confirm('{{ 'Delete this answer for good? This is what answering a request to be forgotten does.'|trans({}, 'theliacms')|e('js') }}')">
                                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                                    {% for field in list_fields %}
                                        <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
                                    {% endfor %}
                                    <input type="hidden" name="page" value="{{ page }}">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">
                                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i> {{ 'Delete'|trans({}, 'theliacms') }}
                                    </button>
                                </form>
                            {% endif %}
                        </span>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            {% for answer in submission.answers %}
                                <dt class="col-sm-4 text-muted fw-normal">{{ answer.label }}</dt>
                                <dd class="col-sm-8">
                                    {% if answer.value is same as(true) %}
                                        {{ yes }}
                                        {% if answer.granted_at is defined %}
                                            {# The moment the agreement was given, which is what has to
                                               be shown if it is ever questioned. #}
                                            <span class="text-muted small">({{ answer.granted_at|date('Y-m-d H:i:s') }})</span>
                                        {% endif %}
                                    {% elseif answer.value is same as(false) %}
                                        {{ no }}
                                    {% elseif answer.value is empty %}
                                        <span class="text-muted">—</span>
                                    {% else %}
                                        {{ answer.value|nl2br }}
                                    {% endif %}
                                </dd>
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if pages > 1 %}
            <nav class="mt-3" aria-label="{{ 'Pages of answers'|trans({}, 'theliacms') }}">
                <ul class="pagination mb-0">
                    {% for number in 1..pages %}
                        <li class="page-item {{ number == page ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('admin.cms.forms.submissions', list_parameters|merge({ id: cms_form.id, page: number })) }}"
                               {{ number == page ? 'aria-current="page"' : '' }}>{{ number }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    {% endif %}

    <p class="text-muted small mt-3 mb-0">
        {% if cms_form.retentionDays > 0 %}
            {{ 'Answers are deleted on their own %days% days after they arrive, as this form says.'|trans({'%days%': cms_form.retentionDays}, 'theliacms') }}
        {% else %}
            {{ 'This form keeps its answers until someone deletes them, which is rarely what a privacy policy says.'|trans({}, 'theliacms') }}
        {% endif %}
    </p>
    <script src="{{ cms_asset('assets/page-filters.js') }}?v={{ assets_version }}" defer></script>
    {% if may_select %}
        <script src="{{ cms_asset('assets/submissions.js') }}?v={{ assets_version }}" defer></script>
    {% endif %}
{% endblock %}
